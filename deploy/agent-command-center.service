[Unit]
Description=Agent Command Center (v1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/SuperPersonalPlatform-v1-deploy
EnvironmentFile=%h/.super-personal-platform/.env
Environment=APP_DATA_DIR=%h/.super-personal-platform/data
Environment=APP_DATABASE_URL=sqlite+aiosqlite:///%h/.super-personal-platform/data/app.db
ExecStart=%h/SuperPersonalPlatform-v1-deploy/.venv/bin/uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8888
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target
