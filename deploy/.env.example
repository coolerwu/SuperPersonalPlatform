# Host systemd (production) environment file.
# Copy to ~/.super-personal-platform/.env and fill in.
APP_AUTH_TOKEN=change-me
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Optional overrides (defaults shown):
# APP_HOME=~/.super-personal-platform
# APP_DATA_DIR=~/.super-personal-platform/data
# APP_WORKSPACES_DIR=~/.super-personal-platform/workspaces
# APP_SKILLS_DIR=~/.super-personal-platform/skills

# Run execution (defaults shown)
# RUN_TIMEOUT_SECONDS=300
# RUN_RECURSION_LIMIT=200

# Browser tools (skill-gated, defaults shown)
# Also caps concurrent Runs across different sessions.
# BROWSER_CONCURRENCY=2
# BROWSER_NAVIGATION_TIMEOUT_MS=30000
# BROWSER_ACTION_TIMEOUT_MS=10000
# BROWSER_SETTLE_MS=500
# BROWSER_MAX_ELEMENTS=120
# BROWSER_MAX_TEXT_CHARS=4000
# BROWSER_MAX_SNAPSHOT_CHARS=12000
# BROWSER_SCREENSHOT_MAX_BYTES=4000000
# BROWSER_NO_SANDBOX=false
