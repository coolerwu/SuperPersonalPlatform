# Host systemd (production) environment file.
# Copy to ~/.super-personal-platform/.env and fill in.
APP_AUTH_TOKEN=change-me
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Unified outbound HTTP proxy (optional). Applies to LLM, web tools, WeChat and
# market data; the API exports these values to the process environment.
# HTTP_PROXY=http://192.168.1.2:7893
# HTTPS_PROXY=http://192.168.1.2:7893
# NO_PROXY=127.0.0.1,localhost

# Optional overrides (defaults shown):
# APP_HOME=~/.super-personal-platform
# APP_DATA_DIR=~/.super-personal-platform/data
# APP_WORKSPACES_DIR=~/.super-personal-platform/workspaces
# APP_SKILLS_DIR=~/.super-personal-platform/claude/skills
# APP_KNOWLEDGE_DIR=~/.super-personal-platform/knowledge

# Run execution (defaults shown)
# RUN_TIMEOUT_SECONDS=900
# Cached SDK clients: each holds a CLI subprocess. Idle TTL, LRU cap, sweep.
# CLAUDE_CLIENT_TTL_SECONDS=300
# CLAUDE_CLIENT_MAX_CLIENTS=8
# CLAUDE_CLIENT_SWEEP_SECONDS=60
# CLAUDE_CONNECT_TIMEOUT_SECONDS=60
# SESSION_RETENTION_DAYS=30  # only seeds data/settings.json on first startup; edit it on the config page afterwards
# SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Cron jobs (in-process scheduler; defaults shown)
# CRON_TICK_SECONDS=20
# CRON_DEFAULT_TIMEZONE=Asia/Shanghai

# WeChat channels (iLink Bot API, in-process runtime; defaults shown)
# CHANNEL_REPLY_MAX_CHARS=1800
# CHANNEL_DELIVERY_MAX_ATTEMPTS=3
# CHANNEL_INBOUND_MAX_CHARS=8000
# CHANNEL_INBOUND_BATCH_SECONDS=5
# CHANNEL_INBOUND_BATCH_MAX_SECONDS=15
# CHANNEL_MEDIA_MAX_BYTES=20971520
# CHANNEL_MEDIA_MAX_ITEMS=4
# VISION_MAX_IMAGES=4
# VISION_MAX_IMAGE_BYTES=4194304
# VISION_MAX_IMAGE_EDGE=1600
# WEIXIN_LONG_POLL_TIMEOUT_MS=35000
# WEIXIN_API_TIMEOUT_MS=15000
# WEIXIN_QR_TIMEOUT_MS=35000

# Personal knowledge base (WebDAV mirror, in-process sync; defaults shown).
# Prefer the config page's "知识库" tab; these values only seed
# data/settings.json on the first startup, before the page has saved a configuration. Use a third-party
# app password, not the account login password. KB_WEBDAV_ROOT is relative to
# the WebDAV base URL.
# KB_WEBDAV_URL=https://dav.jianguoyun.com/dav/
# KB_WEBDAV_USERNAME=you@example.com
# KB_WEBDAV_PASSWORD=
# KB_WEBDAV_ROOT=
# KB_SYNC_INTERVAL_SECONDS=300
# KB_SYNC_TIMEOUT_SECONDS=30
# KB_MAX_FILE_BYTES=52428800
# Nutstore rate limits: free accounts allow ~600 requests per 30 minutes
# across all apps. The sync paces requests and pauses on BlockedTemporarily.
# KB_REQUEST_INTERVAL_SECONDS=4.5
# KB_EXCLUDE_DIRS=.obsidian,.git,.trash,node_modules,.DS_Store
# KB_MAX_LISTING_ENTRIES=750
# KB_BLOCKED_RETRY_SECONDS=1800

# Browser tools are not wired into the SDK runtime yet; these settings are
# kept for the tool-layer migration. BROWSER_CONCURRENCY also caps concurrent
# turns across different sessions.
# BROWSER_CONCURRENCY=5
# Normal desktop identity + persistent login state (cookies/localStorage in
# data/browser_state.json). Sites that reject headless traffic show their
# normal login page instead of an anti-bot block.
# BROWSER_NORMAL_IDENTITY=true
# BROWSER_USER_AGENT=
# BROWSER_LOCALE=zh-CN
# BROWSER_TIMEZONE=Asia/Shanghai
# BROWSER_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8
# BROWSER_PERSIST_STATE=true
# BROWSER_STATE_PATH=
# BROWSER_NAVIGATION_TIMEOUT_MS=30000
# BROWSER_ACTION_TIMEOUT_MS=10000
# BROWSER_SETTLE_MS=500
# BROWSER_MAX_ELEMENTS=120
# BROWSER_MAX_TEXT_CHARS=4000
# BROWSER_MAX_SNAPSHOT_CHARS=12000
# BROWSER_SCREENSHOT_MAX_BYTES=4000000
# BROWSER_NO_SANDBOX=false

# Crypto market data (Bitget public REST) and backtesting.
# If Bitget is not reachable directly, configure the proxy above.
# BITGET_BASE_URL=https://api.bitget.com
# MARKET_HTTP_TIMEOUT_SECONDS=15
# MARKET_RATE_LIMIT_PER_SECOND=5
# MARKET_MAX_RETRIES=3
# MARKET_GAP_REPAIR_BARS=50000
# MARKET_GAP_REPAIR_RANGES=50
# BACKTEST_CONCURRENCY=1
# BACKTEST_TIMEOUT_SECONDS=120
# BACKTEST_FETCH_TIMEOUT_SECONDS=600
# BACKTEST_TOOL_WAIT_SECONDS=90
# BACKTEST_MEMORY_LIMIT_MB=2048
# BACKTEST_MAX_BARS=200000
# BACKTEST_MAX_TRADES=5000
# BACKTEST_EQUITY_POINTS=2000
# BACKTEST_FUTURE_CHECK=true
